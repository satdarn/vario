module example;

enum Direction {
    North = 0,
    South,
    East,
    West,
}

union Result {
    ok: i32,
    err: i32,
	count: *Counter,
}

obj Counter {
    var count: i32;
    var step: i32;

    fn init(start: i32, step: i32) -> Counter {
        var c: Counter;
        c.count = start;
        c.step = step;
        return c;
    }

    fn deinit(self: *Counter) -> void {
        return;
    }

    fn increment(self: *Counter) -> void {
        self.count = self.count + self.step;
        return;
    }

    fn get(self: *Counter) -> i32 {
        return self.count;
    }

    fn reset(self: *Counter) -> void {
        self.count = 0;
        return;
    }
}

fn factorial(n: i32) -> i32 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn max(a: i32, b: i32) -> i32 {
    if (a > b) {
        return a;
    }
    return b;
}

fn sum_array(arr: []i32) -> i32 {
    var total: i32 = 0;
    for value: arr {
        total = total + value;
    }
    return total;
}

fn fizzbuzz(n: i32) -> void {
    var i: i32 = 1;
    while (i <= n) {
        var fizz: bool = (i % 3) == 0;
        var buzz: bool = (i % 5) == 0;
        if (fizz && buzz) {
            println("FizzBuzz");
        } else if (fizz) {
            println("Fizz");
        } else if (buzz) {
            println("Buzz");
        } else {
        //    println(i);
        }
        i = i + 1;
    }
    return;
}

