// ============================================================
// exhaustive_valid.var
//
// Syntax-coverage fixture: exercises every production in grammar.txt,
// plus the generics/interfaces additions, in one file. Every construct
// here is intentionally semantically meaningless — this file exists to
// stress the PARSER, not sema. It should parse with had_errors == false
// and produce a complete, sane AST.
//
// Known gaps (in grammar.txt but not yet implemented in parser.c as of
// this writing, so deliberately NOT exercised below):
//   - constructor_decl ("fn" "init" ...)
//   - destructor_decl  ("fn" "deinit" ...)
// Add a section for these once parse_constructor_decl/parse_destructor_decl
// exist.
// ============================================================

module exhaustive;

import std;
import collections as coll;

// ------------------------------------------------------------
// CONSTANTS
// ------------------------------------------------------------
const MAX_SIZE: usize = 128;
pub const VERSION: i32 = 1;

// ------------------------------------------------------------
// INTERFACES
// ------------------------------------------------------------
inter Add {
    fn add(self: *Self, other: Self) -> Self;
};

inter Clone {
    fn clone(self: *Self) -> Self;
};

inter Comparable {
    fn compare(self: *Self, other: Self) -> i32;
    fn equals(self: *Self, other: Self) -> bool;
};

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------
enum Color {
    Red,
    Green,
    Blue,
};

pub enum Status {
    Ok = 0,
    Warning = 1,
    Error = 2,
};

// ------------------------------------------------------------
// TAGGED UNIONS
// ------------------------------------------------------------
union Value {
    as_int: i32,
    as_float: f64,
    as_bool: bool,
};

// ------------------------------------------------------------
// OBJECTS — plain, generic (single + multi param), fields + methods
// ------------------------------------------------------------
obj Point {
    var x: i32;
    var y: i32;

    fn origin() -> Point {
        var p: Point;
        return p;
    }

    fn length(self: *Point) -> f64 {
        return 0.0;
    }

    fn translate(self: *Point, dx: i32, dy: i32) -> void {
        self.x = self.x + dx; // ERROR HERE
        self.y = self.y + dy; // ERROR HERE
    }
};

obj Vec[T] {
    var data: []T;
    var len: usize;
    var cap: [16]T;                 // fixed-size array field: [N]T

    fn push(self: *Vec[T], item: T) -> void {
        self.len = self.len + 1; // ERROR
    }

    fn at(self: *Vec[T], i: usize) -> T {
        return self.data[i]; //ERROR
    }
};

pub obj Pair[K, V] {
    var key: K;
    var value: V;
};

// ------------------------------------------------------------
// GENERIC FUNCTIONS — unbounded, single bound, multi-bound (+)
// ------------------------------------------------------------
fn identity[T](x: T) -> T {
    return x;
}

fn add_all[T: Add](a: T, b: T) -> T {
    return a.add(b);
}

fn duplicate[T: Clone](x: T) -> T {
    return x.clone();
}

fn merge[T: Add + Clone](a: T, b: T) -> T {
    let c: T = a.clone();
    return c.add(b);
}

// ------------------------------------------------------------
// TYPES — primitives, pointers, slices/arrays, generic instantiation
// ------------------------------------------------------------
fn types_demo(
    a: u8, b: u32, c: u64,
    d: i32, e: i64,
    f: f32, g: f64,
    h: bool, i: usize, j: isize,
    k: *i32,               // pointer
    l: []i32,               // slice
    m: [10]i32,             // fixed-size array
    n: **i32,               // pointer to pointer
    o: Vec[i32],            // generic instantiation as a param type
    p: Pair[i32, bool]      // multi-arg generic instantiation
) -> void {
    var q: Vec[i32];
    var r: Point;
}

// ------------------------------------------------------------
// STATEMENTS — declarations, every assignment operator, control flow
// ------------------------------------------------------------
fn statements_demo() -> i32 {
    var x: i32 = 0;
    let y: i32 = 10;
    var arr: [5]i32;

    x = 1;
    x += 1;
    x -= 1;
    x *= 2;
    x /= 2;
    x %= 3;
    x &= 1;
    x |= 2;
    x ^= 3;
    x <<= 1;
    x >>= 1;

    statements_demo();          // expression_stmt

    if x > 0 {
        x = x + 1;
    } else if x < 0 { // ERROR
        x = x - 1;
    } else {
        x = 0;
    }

    while x < 100 {
        x = x + 1;
    }

    for (var i: i32 = 0; i < 10; i += 1) {
        x = x + i;
    }

    for item : arr {
        x = x + item;
    }

    switch x {
    case 0, 1, 2:{
        x = 100;
	}
    case 3:{
        x = 200;
	}
    default: {
        x = 300;
	}
    }

    defer x = 0;

    {
        var nested: bool = true;    // block_stmt
    }

    if x > 0 {
        return x;
    }
    return 0;
}

fn loop_control_demo() -> void {
    while true {
        continue;
        break;
    }
}

// ------------------------------------------------------------
// EXPRESSIONS — full precedence chain, postfix ops, primaries
// ------------------------------------------------------------
fn expr_demo(a: i32, b: i32, p: *i32) -> i32 {
    var r: i32 = a;

    r = a + b; r = a - b; r = a * b; r = a / b; r = a % b;
    r = a < b; r = a <= b; r = a > b; r = a >= b;
    r = a == b; r = a != b;

    r = -a;
    r = ~a;
    r = *p;               // deref
    r = &a;                // address-of

    r = expr_demo(a, b, p);        // call
    r = (a + b) * (a - b);         // grouping
    r = sizeof(i32);
    r = r as i32;                    // cast — infix 'as', no grouping ambiguity
    r = (r as i32) as i64 as i32;    // chained casts, left-associative

    var arr: []i32 = [1, 2, 3, 4, 5];
    r = arr[0];             // indexing
    r = arr[1:3];            // slicing, both bounds
    r = arr[:3];              // slicing, omitted start
    r = arr[1:];               // slicing, omitted end

    r++;
    r--;

    return r;
}

fn bool_expr_demo(flag_a: bool, flag_b: bool) -> bool {
    var r: bool = flag_a || flag_b;
    r = flag_a && flag_b;
    r = !flag_a;
    return r;
}

fn literal_demo() -> void {
    var a: i32 = 42;
    var b: i32 = 0x2A;
    var c: i32 = 0o52;
    var d: i32 = 0b101010;
    var e: f64 = 3.14;
    var f: f64 = 6.02e-23;
    var g: bool = true;
    var h: bool = false;
    var s: []u8 = "hello, world";
    var arr: []i32 = [1, 2, 3];
}

// ------------------------------------------------------------
// Entry point
// ------------------------------------------------------------
fn main() -> i32 {
    return 0;
}
